---
import Hero from "@components/sections/hero/hero.astro";
import AboutMe from "@components/sections/about-me/aboutMe.astro";
import SectionHeader from "@components/headers/sectionHeader.astro";
import HorizontalCaseStudyCard from "@components/cards/horizontalCaseStudyCard.astro";
import WebsiteCard from "@components/cards/websiteCard.astro";
import DisplayHeader from "@components/headers/displayHeader.astro";
import Section from "@components/sections/section.astro";
import Grid from "@components/container/grid.astro";
import SocialLink from "@components/buttons/socialLink.astro";
import ArticleRow from "@components/blog/articleRow.astro";
import ArrowRight from "@assets/icons/arrow-right.svg";
import JsonLd from "@/components/seo/jsonLd.astro";
import { buildPersonSchema, buildWebsiteSchema } from "@/utils/personSchema";
import getGlobals from "@/utils/getGlobals";
import getBlogData from "@/utils/getBlogData";
import { cmsURL } from "@/constants";
import Layout from "@/layouts/layout.astro";
import type { ContactLinkType } from "@customTypes/contactLinkType";
import type { CardContentType } from "@customTypes/cardContentType";

const { homepageData, contacts, settings } = await getGlobals(Astro.locals);

const structuredData = [
  buildPersonSchema(contacts.contactLinks),
  buildWebsiteSchema(settings.siteTitle),
];

// The hero shows whichever links are ticked under Homepage -> Hero; the CTA
// row and case-study footer always keep every link. An empty selection means
// "all", so the hero is never accidentally left bare.
const allContactLinks = contacts.contactLinks as ContactLinkType[];
const heroSelection: string[] = homepageData.heroSection?.contactLinks ?? [];
const heroContactLinks = heroSelection.length
  ? allContactLinks.filter((link) => link.id && heroSelection.includes(link.id))
  : allContactLinks;

const caseStudiesSection = homepageData.caseStudies;
const websitesSection = homepageData.websites;
const blogSection = homepageData.blog ?? {};

// `/api/posts/all` already comes back newest first, so the homepage's blog
// section is just the top of that list — nothing to choose in the CMS.
const { posts } = await getBlogData(Astro.locals);
const latestPosts = posts.slice(0, blogSection.postCount ?? 3);

// Showcased projects come back as ids at depth 0. Each collection exposes a
// `/:id/thumbnail` endpoint returning the flattened card content (title, rich
// text description, link label, url, image) — same contract the previous
// card section used.
async function loadThumbnails(
  collection: "case-studies" | "websites",
  ids: string[] = [],
): Promise<CardContentType[]> {
  const results = await Promise.all(
    ids.map(async (projectID) => {
      try {
        const res = await fetch(
          `${cmsURL}/api/${collection}/${projectID}/thumbnail`,
        );
        if (!res.ok) return null;
        const data = await res.json();
        return data?.error ? null : (data as CardContentType);
      } catch {
        return null;
      }
    }),
  );
  return results.filter((r): r is CardContentType => r !== null);
}

const [caseStudies, websites] = await Promise.all([
  loadThumbnails("case-studies", caseStudiesSection.showcasedProjects),
  loadThumbnails("websites", websitesSection.showcasedProjects),
]);

// The browser should always check freshness
Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=0, must-revalidate"
);

// The CDN caches for a year, invalidated by tag when content changes
Astro.cache.set({
  maxAge: 31536000,
  tags: ["global", "case-studies", "websites", "posts"],
});
---

<Layout pageMetaDescription={settings.siteDescription}>
  <JsonLd graph={structuredData} slot="head" />

  <Hero data={homepageData.heroSection} contactLinks={heroContactLinks} />

  <Section class={["bg-white py-16 md:py-20"]} id="case-studies">
    <SectionHeader number={caseStudiesSection.sectionNumber} class="mb-10 md:mb-12">
      {caseStudiesSection.sectionTitle}
    </SectionHeader>
    <div class="flex flex-col gap-16 md:gap-12">
      {
        caseStudies.map((project) => (
          <HorizontalCaseStudyCard content={project} href={`/${project.url}`} />
        ))
      }
    </div>
  </Section>

  <Section class={["bg-gray-50 py-16 md:py-20"]} id="websites">
    <SectionHeader number={websitesSection.sectionNumber} class="mb-10 md:mb-12">
      {websitesSection.sectionTitle}
    </SectionHeader>
    <Grid class="gap-y-12">
      {
        websites.map((project) => (
          <div class="col-span-12 md:col-span-6">
            <WebsiteCard content={project} />
          </div>
        ))
      }
    </Grid>
  </Section>

  {
    latestPosts.length > 0 && (
      <Section class={["bg-gray-50 py-16 md:py-20"]} id="blog">
        <SectionHeader number={blogSection.sectionNumber} class="mb-10 md:mb-12">
          {blogSection.sectionTitle ?? "Blog"}
        </SectionHeader>

        <!-- Each row carries its own bottom rule, so the list closes itself
             but has nothing above the first entry. The top rule lives on the
             list rather than the row: on the blog index a year heading opens
             each group, and rows there must not draw one of their own. -->
        <ul class="flex flex-col border-t-[0.5px] border-gray-500/50">
          {latestPosts.map((post) => (
            <ArticleRow post={post} />
          ))}
        </ul>

        <a
          href="/blog"
          tabindex="0"
          data-astro-prefetch
          class="group mt-10 inline-flex w-fit items-center justify-center gap-3 bg-text-primary p-5 text-ui text-white transition-colors hover:bg-gray-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-600 md:mt-12"
        >
          {blogSection.linkLabel ?? "See all articles"}
          <ArrowRight
            width={24}
            height={24}
            aria-hidden="true"
            class="shrink-0 transition-transform duration-200 ease-out group-hover:translate-x-1"
          />
        </a>
      </Section>
    )
  }

  <AboutMe data={homepageData.aboutMe} />

  <Section class={["bg-white pt-16 pb-16 md:pt-24 md:pb-24"]} id="contact">
    <DisplayHeader level="h2">{homepageData.contact.header}</DisplayHeader>
    <ul
      class="mt-16 flex flex-col gap-8 md:mt-32 md:flex-row md:flex-wrap md:justify-between md:gap-x-8 md:gap-y-10"
    >
      {
        contacts.contactLinks.map((link: ContactLinkType) => (
          <li>
            <SocialLink
              href={link.url}
              label={link.title}
              class="text-body text-text-secondary"
            >
              {link.title}
            </SocialLink>
          </li>
        ))
      }
    </ul>
  </Section>
</Layout>
