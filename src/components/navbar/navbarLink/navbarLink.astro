---
import type { NavLinkType } from "@customTypes/navLinkType";
import ArrowUpRight from "@assets/icons/arrow-up-right.svg";
interface Props extends NavLinkType {}
const { title, url } = Astro.props;
---

<li
  class="flex-initial w-full flex flex-row content-center items-center gap-3 md:gap-2 hover:underline hover:decoration-1 hover:decoration-blue-950 hover:text-blue-950/90 underline-offset-4 md:w-auto"
>
  <a
    href={url}
    tabindex="0"
    target={url.startsWith("http") ? "__blank" : ""}
    class="relative flex flex-row flex-wrap w-full ps-3 py-6 md:px-0 md:py-0 items-center justify-between md:gap-2 md:after:absolute md:after:inset-[-15px]"
    >{title}

    {
      url.startsWith("http") && (
        <ArrowUpRight
          width={17}
          height={17}
          aria-hidden="true"
          class="shrink-0 me-3 md:me-0"
        />
      )
    }
  </a>
</li>
