---
/**
 * The site's layout grid: 12 columns, 32px gutter.
 *
 * Within the 1200px container this reproduces the design's measurements
 * exactly — a column is 70.67px, so 3 columns is 276px (hero portrait),
 * 4 is 379px (case-study copy), 6 is 584px (development card) and 8 is
 * 789px (case-study screenshot).
 *
 * Only the column gutter is fixed here; row spacing varies per section and
 * is passed in via `class` (e.g. `gap-y-12`).
 *
 * The gutter is held back until `s` because a 12-column grid reserves its 11
 * gaps whether or not anything sits either side of them: at 32px that is a
 * 352px floor the grid will not shrink below, which forced the whole page to
 * overflow on narrow phones. Every item is `col-span-12` below `s` — the
 * first partial span is `s:col-span-6` — so no column gap is visible there
 * anyway, and dropping it costs nothing while letting the page reflow all the
 * way down. Row gaps are unaffected.
 */
interface Props {
  class?: string;
  /** Rendered element. `ul`/`ol` for lists of cards. */
  as?: "div" | "ul" | "ol";
}

const { class: className, as: Tag = "div" } = Astro.props;
---

<Tag class:list={["grid grid-cols-12 gap-x-0 s:gap-x-8", className]}>
  <slot />
</Tag>
