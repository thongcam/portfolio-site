---
/**
 * Homepage hero: portrait, headline, intro paragraph with availability
 * status, and the contact column.
 *
 * Layouts, by breakpoint:
 *  - <s (434)    portrait full width, then headline, intro and contacts
 *  - s           portrait on its own row at 6 columns so it stays modest;
 *                the text block still spans all 12 beneath it
 *  - md (741)    portrait (4 cols) beside the text (8); intro and contacts
 *                share one column, contacts wrapping as a row
 *  - lg (1047)   intro and contacts split side by side, contacts right-aligned
 *  - xl (1200)   portrait narrows to the design's 3 columns (276px)
 */
import { Image } from "astro:assets";
import Section from "../section.astro";
import Grid from "@components/container/grid.astro";
import HeroHeadline from "@components/headers/heroHeadline.astro";
import SocialLink from "@components/buttons/socialLink.astro";
import { cmsURL } from "@/constants";
import type { ContactLinkType } from "@customTypes/contactLinkType";

interface Props {
  data: {
    mainHeader: any;
    heroPortrait: { url: string; width: number; height: number; alt: string };
    standoutCard: { content: string; tagline: string };
  };
  contactLinks: ContactLinkType[];
}

const { data, contactLinks } = Astro.props;
const portrait = data.heroPortrait;

// 6 of 12 columns from s (own row), 4 from md, 3 from xl (276px inside the
// 1200px container). Percentages are of the viewport, not the container.
const SIZES =
  "(min-width: 1200px) 20vw, (min-width: 741px) 27vw, (min-width: 434px) 40vw, calc(100vw - 3rem)";
---

<Section class={["bg-white py-8 md:py-16"]} id="hero">
  <Grid class="gap-y-8">
    <Image
      src={cmsURL + portrait.url}
      width={portrait.width}
      height={portrait.height}
      alt={portrait.alt || ""}
      quality={80}
      priority
      loading="eager"
      sizes={SIZES}
      class="col-span-12 w-full object-cover object-top aspect-[4/5] s:col-span-6 md:col-span-4 xl:col-span-3 shadow-lg"
    />

    <div class="col-span-12 flex flex-col gap-8 md:col-span-8 xl:col-span-9">
      <HeroHeadline data={data.mainHeader} />

      <div class="flex flex-col gap-6 lg:flex-row lg:justify-between lg:gap-8">
        <div class="flex flex-col gap-4 lg:min-w-0 lg:max-w-[479px]">
          <p class="text-body text-text-primary text-pretty">
            {data.standoutCard.content}
          </p>
          {
            data.standoutCard.tagline && (
              <p class="flex items-center gap-2 text-body text-cyan-400">
                <span
                  class="size-3 shrink-0 rounded-full bg-cyan-400"
                  aria-hidden="true"
                />
                {data.standoutCard.tagline}
              </p>
            )
          }
        </div>

        <ul
          class="flex flex-col gap-2 md:flex-row md:flex-wrap md:gap-x-8 md:gap-y-2 lg:flex-col lg:flex-nowrap lg:shrink-0 lg:items-end"
        >
          {
            contactLinks.map((link: ContactLinkType) => (
              <li>
                <SocialLink
                  href={link.url}
                  label={link.title}
                  class="text-body text-text-tertiary whitespace-nowrap"
                >
                  {link.title}
                </SocialLink>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Grid>
</Section>
