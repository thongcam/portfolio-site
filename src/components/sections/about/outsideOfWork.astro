---
/**
 * "Outside of work…": the statement on the left, the scattered photos on the
 * right.
 *
 * The photos are a React island because the interaction is stateful — drag
 * positions, stack order, which one is flipped open. It hydrates on visible:
 * the section sits low on the page, and none of it is needed until it is.
 *
 * `overflow-x-clip` on the section (not `hidden`, which would kill the sticky
 * intro's positioning context further up) keeps a dragged photo from widening
 * the page, while still letting the tilted cards spill above and below their
 * container as the design draws them.
 */
import { getImage } from "astro:assets";
import Section from "@components/sections/section.astro";
import HeroHeadline from "@components/headers/heroHeadline.astro";
import PhotoScatter, {
  type ScatterPhoto,
} from "@components/about/PhotoScatter";
import { cmsURL } from "@/constants";

interface Props {
  statement: any;
  photos: {
    image: { url: string; alt?: string; width: number; height: number };
    description: string;
  }[];
}

const { statement, photos } = Astro.props;

/**
 * A polaroid's photo is never drawn wider than ~285px (41.4% of the scatter,
 * which itself caps at the container's 1200px), or ~182px while stacked.
 * These candidates cover both, up to a 2x display.
 */
const PHOTO_WIDTHS = [200, 300, 400, 600];

/**
 * ~20vw once the statement and the scatter share a row, ~40vw stacked. The
 * mobile figure is the narrow-phone case, where the scatter has not yet hit
 * its max width; wider phones only ever need less.
 */
const PHOTO_SIZES = "(min-width: 741px) 20vw, 40vw";

/**
 * The photos are resized here rather than in the island.
 *
 * `astro:assets` runs on the server, so a React island cannot use `<Image>`
 * — pointing an `<img>` straight at the CMS URL, as this did, served the
 * untouched original: four of them came to 6.8MB to paint cards a couple of
 * hundred pixels wide. Doing the work here and handing the island a plain
 * `src`/`srcset` pair keeps it to the same treatment every other image on the
 * site gets.
 */
const scatterPhotos: ScatterPhoto[] = await Promise.all(
  (photos ?? []).map(async (photo) => {
    const optimised = await getImage({
      src: cmsURL + photo.image.url,
      width: photo.image.width,
      height: photo.image.height,
      widths: PHOTO_WIDTHS,
      sizes: PHOTO_SIZES,
      format: "webp",
      quality: 80,
    });

    return {
      url: optimised.src,
      srcSet: optimised.srcSet.attribute || undefined,
      sizes: PHOTO_SIZES,
      alt: photo.image.alt || photo.description,
      description: photo.description,
    };
  }),
);
---

<Section class={["bg-white py-16 overflow-x-clip md:py-40"]} id="outside-of-work">
  <!-- `md:gap-10` rather than the design's 34px: the gap also has to
       clear the blur that appears beside the scatter when a photo is
       opened, which reaches out far enough to cover the tilted cards. -->
  <div class="flex flex-col gap-16 md:flex-row md:items-center md:gap-10">
    <HeroHeadline
      data={statement}
      level="h2"
      typography="text-h2 text-text-tertiary"
      class="md:w-[40%] md:shrink-0"
    />

    {
      scatterPhotos.length > 0 && (
        <div class="min-w-0 flex-1" data-photo-scatter>
          <PhotoScatter photos={scatterPhotos} client:visible />
        </div>
      )
    }
  </div>
</Section>

<!-- `is:global` because the photos are rendered by the React island, not by
     this file's template: Astro's scoped styles stamp a per-component
     attribute onto its own markup only, so a scoped selector would never
     reach `[data-photo]`.

     Armed and revealed from a plain script rather than from the island,
     because `client:visible` leaves the server-rendered photos on screen
     until React hydrates — starting the entrance from React would show them
     first and then blink them out. Arming here hides them the moment the page
     parses, and the whole thing is gated behind `is-armed` so that with
     scripting off they are simply visible. -->
<style is:global>
  @keyframes scatter-float-in {
    from {
      opacity: 0;
      /* The individual `translate` property, not `transform`: the island
         drives `transform` for dragging, and the two compose rather than
         overwrite each other. */
      translate: 0 1.5rem;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  [data-photo-scatter].is-armed [data-photo] {
    opacity: 0;
  }

  [data-photo-scatter].is-armed.is-revealed [data-photo] {
    animation: scatter-float-in 620ms cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
    /* Left to right: photo index ascends with horizontal position when the
       scatter is spread out, and follows reading order once it stacks. */
    animation-delay: calc(var(--photo-index, 0) * 130ms);
  }

  @media (prefers-reduced-motion: reduce) {
    [data-photo-scatter].is-armed [data-photo] {
      opacity: 1;
      translate: none;
      animation: none !important;
    }
  }
</style>

<script>
  const scatters = document.querySelectorAll<HTMLElement>("[data-photo-scatter]");

  scatters.forEach((scatter) => scatter.classList.add("is-armed"));

  const observer = new IntersectionObserver(
    (entries, obs) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add("is-revealed");
        // One-shot: the photos should not fly in again on every pass.
        obs.unobserve(entry.target);
      });
    },
    { rootMargin: "0px 0px -10% 0px", threshold: 0.2 },
  );

  scatters.forEach((scatter) => observer.observe(scatter));
</script>
