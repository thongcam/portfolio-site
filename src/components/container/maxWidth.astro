---
/**
 * Page container.
 *
 * The design's "Container XL" is 1200px of *content*, with the page gutter
 * outside it — so the cap lives on an inner element rather than on the padded
 * box. Capping the padded box instead (as this did previously) left only
 * 1040px of content at wide viewports.
 *
 * At the design's 1512px canvas this resolves to a 1200px column with 156px
 * margins, matching the Figma exactly.
 *
 * Below `s` the gutter is a flat 20px. The fluid `7vw` term is only worth
 * having once the layout starts putting things side by side; on a phone it
 * just eats width the content needs — at 393px it worked out to 27.5px a
 * side. The clamp's own floor is kept at the same 20px so the two agree if
 * the `s` breakpoint ever moves.
 */
interface Props {
  class: string;
}
const { class: className } = Astro.props;
---

<div class="px-5 s:px-[clamp(1.25rem,7vw,5rem)]">
  <div class:list={["max-w-[1200px] m-auto", className]}>
    <slot />
  </div>
</div>
