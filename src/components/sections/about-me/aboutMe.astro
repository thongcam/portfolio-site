---
/**
 * About me: a dark copy card butted against a portrait, with the animated
 * ring decorator behind the portrait's right edge.
 *
 * Laid out proportionally rather than on the 12-column grid: the design's
 * three widths (617 / 377 / 449 of 1200) don't land on column boundaries,
 * and the three have to hold their relation to each other as the page
 * narrows. Percentages come straight from the Figma:
 *
 *   card   617     / 1200 = 51.4167%
 *   image  376.685 / 1200 = 31.3904%   (card + image = 82.807%, no gap)
 *   ring   449     / 1200 = 37.4167%, starting at 751/1200 = 62.5833%
 *
 * The ring therefore begins inside the image's span — leaving it about half
 * occluded — and ends flush with the container's right edge, so the three
 * together measure exactly the content width.
 *
 * The three are aligned on a common horizontal centre line rather than
 * staggered vertically, so their midpoints agree whatever their heights.
 *
 * Breakpoints:
 *   < md   stacked, 32px gap, portrait at 5:4 (tall) filling its box
 *   md     ring hidden so card and image can share the full width without
 *          either getting too thin (617/377 renormalised to 100%)
 *   lg+    all three, as drawn
 */
import { Image } from "astro:assets";
import Section from "../section.astro";
import SectionHeader from "@components/headers/sectionHeader.astro";
import ThreeRings from "@components/decorators/threeRings.astro";
import ArrowRight from "@assets/icons/arrow-right.svg";
import ArrowRightLong from "@assets/icons/arrow-right-long.svg";
import { cmsURL } from "@/constants";

interface Props {
  data: {
    sectionNumber: number;
    sectionTitle: string;
    content: string;
    buttonLabel: string;
    buttonURL: string;
    aboutMePortrait: { url: string; width: number; height: number; alt: string };
  };
}

const { data } = Astro.props;
const portrait = data.aboutMePortrait;
const isExternal = data.buttonURL?.startsWith("http");

// 37.9% of the viewport at md, 31.4% from lg, full gutter width below.
const SIZES =
  "(min-width: 1047px) 32vw, (min-width: 741px) 38vw, calc(100vw - 3rem)";
---

<Section class={["bg-white py-16 md:py-24 overflow-x-clip"]} id="about">
  <SectionHeader number={data.sectionNumber} class="mb-10 md:mb-6">
    {data.sectionTitle}
  </SectionHeader>

  <div class="relative flex flex-col gap-8 md:flex-row md:items-center md:gap-0">
    <!-- Decorative; sits behind the portrait and animates in on scroll. -->
    <ThreeRings
      class="pointer-events-none absolute left-[62.5833%] top-1/2 z-0 hidden aspect-square w-[37.4167%] -translate-y-1/2 lg:block"
      enableAnimation={true}
      fromCorner={false}
    />

    <div
      class="relative z-10 flex flex-col gap-16 overflow-hidden bg-blue-950 px-6 py-8 md:w-[62.0919%] md:gap-16 lg:gap-24 md:px-8 md:py-8 lg:w-[51.4167%]"
    >
      <!-- Faint tilted rectangle, as in the Figma card background. -->
      <span
        aria-hidden="true"
        class="pointer-events-none absolute -left-16 -top-24 z-0 size-[325px] -rotate-[20deg] border-[30px] border-blue-900 opacity-25"
      ></span>

      <p class="relative z-10 text-body text-white text-pretty">{data.content}</p>

      <a
        href={data.buttonURL}
        target={isExternal ? "_blank" : undefined}
        rel={isExternal ? "noopener noreferrer" : undefined}
        tabindex="0"
        class="group relative z-10 inline-flex w-fit items-center gap-2 text-body text-yellow-400 transition-opacity hover:opacity-80 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-yellow-400"
      >
        {data.buttonLabel}
         <ArrowRight
        width={24}
        height={24}
        aria-hidden="true"
        class="shrink-0 transition-transform duration-200 ease-out group-hover:translate-x-1"
        />
      </a>
    </div>

    <Image
      src={cmsURL + portrait.url}
      width={portrait.width}
      height={portrait.height}
      alt={portrait.alt || ""}
      quality={80}
      loading="lazy"
      sizes={SIZES}
      class="relative z-10 w-full object-cover aspect-[2/3] md:w-[37.9081%] lg:w-[31.3904%]"
    />
  </div>
</Section>
