---
/**
 * Page container.
 *
 * The design's "Container XL" is 1200px of *content*, with the page gutter
 * outside it — so the cap lives on an inner element rather than on the padded
 * box. Capping the padded box instead (as this did previously) left only
 * 1040px of content at wide viewports.
 *
 * At the design's 1512px canvas this resolves to a 1200px column with 156px
 * margins, matching the Figma exactly.
 *
 * The gutter value itself lives on `--page-gutter` in global.css, because
 * the mobile menu in navbar.astro has to line up with it.
 */
interface Props {
  class: string;
}
const { class: className } = Astro.props;
---

<div class="px-[var(--page-gutter)]">
  <div class:list={["max-w-[1200px] m-auto", className]}>
    <slot />
  </div>
</div>
