---
/**
 * Closing CTA — the same "Let's work together!" block the homepage ends on,
 * which the redesign carries onto case studies too.
 */
import DisplayHeader from "@components/headers/displayHeader.astro";
import SocialLink from "@components/buttons/socialLink.astro";
import Section from "@/components/sections/section.astro";
import type { ContactLinkType } from "@/types/contactLinkType";
import getGlobals from "@/utils/getGlobals";

const { contacts, homepageData } = await getGlobals(Astro.locals);
---

<Section class={["bg-white pt-16 pb-24 md:pt-32 md:pb-32"]} id="contact">
  <DisplayHeader level="h2">{homepageData.contact.header}</DisplayHeader>
  <ul
    class="mt-16 flex flex-col gap-8 md:mt-32 md:flex-row md:flex-wrap md:justify-between md:gap-x-8 md:gap-y-10"
  >
    {
      contacts.contactLinks.map((link: ContactLinkType) => (
        <li>
          <SocialLink
            href={link.url}
            label={link.title}
            class="text-body text-text-secondary"
          >
            {link.title}
          </SocialLink>
        </li>
      ))
    }
  </ul>
</Section>
