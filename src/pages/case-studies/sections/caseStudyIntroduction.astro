---
/**
 * Case-study opener: title, a rule, the summary meta grid, then the banner.
 *
 * The meta grid is the CMS's summary blocks rendered as label/value pairs —
 * three columns on desktop, one on mobile. The timeline is appended as a
 * further cell so the field still has a home; the design's grid leaves a
 * sixth slot empty, which it fills.
 */
import { RichTextLexical } from "@/components/rich-text/richTextLexical";
import Section from "@/components/sections/section.astro";
import { cmsURL } from "@/constants";
import generateArticleColors from "@/utils/generateArticleColors";
import { Image } from "astro:assets";
import Color from "color";
import type { SerializedEditorState } from "lexical";

interface SummaryBlockType {
  title: string;
  content: SerializedEditorState;
}

const { page } = Astro.props;

const themeColor = Color(page.themeColor);
const { themeColorLighter, themeColorRamp500 } = generateArticleColors(themeColor);
const labelColor = themeColorRamp500.hex();

const banner = page.bannerImage;
const thumbnail = page.thumbnail.thumbnailImage;
---

<Section
  class={["pt-12 pb-16 md:pt-20 md:pb-16"]}
  style={{ backgroundColor: themeColorLighter.rgb().string() }}
  id="introduction"
>
  <h1 class="text-article-title text-text-primary text-balance">{page.title}</h1>

  <hr class="mt-12 border-0 border-t-[0.5px] border-blue-950/20 md:mt-16" />

  <dl
    class="mt-8 grid grid-cols-1 gap-8 md:grid-cols-3"
  >
    {
      page.summaryBlocks?.map((block: SummaryBlockType) => (
        <div class="flex flex-col gap-2">
          <dt class="text-label" style={{ color: labelColor }}>
            {block.title}
          </dt>
          <dd class="text-body text-text-primary">
            <RichTextLexical data={block.content} />
          </dd>
        </div>
      ))
    }
    {
      page.timeline && (
        <div class="flex flex-col gap-2">
          <dt class="text-label" style={{ color: labelColor }}>Timeline</dt>
          <dd class="text-body text-text-primary">{page.timeline}</dd>
        </div>
      )
    }
  </dl>

  <!-- Wide banner above `s`; the portrait thumbnail stands in below it, where
       a 3.8:1 crop would be only a sliver tall. -->
  <Image
    src={cmsURL + banner.url}
    alt={banner.alt}
    width={banner.width}
    height={banner.height}
    class="mt-12 hidden w-full rounded-[15px] border-[0.5px] border-gray-300 object-cover aspect-[1200/312] s:block md:mt-16"
    quality={80}
  />
  <Image
    src={cmsURL + thumbnail.url}
    alt={thumbnail.alt}
    width={thumbnail.width}
    height={thumbnail.height}
    class="mt-12 block w-full rounded-[15px] border-[0.5px] border-gray-300 object-cover s:hidden"
    quality={80}
    priority
  />
</Section>

<style>
  /* Summary values are single blocks; the article's rhythm doesn't apply. */
  :global(#introduction dd > *) {
    margin-top: 0;
    padding-top: 0;
  }
</style>
