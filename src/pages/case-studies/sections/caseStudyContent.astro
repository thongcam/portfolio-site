---
import { RichTextLexical } from "@/components/rich-text/richTextLexical";
import ScrollSpy from "@/components/scroll-spy/scrollSpy.astro";
import Section from "@/components/sections/section.astro";
import useAstroImage from "@utils/useAstroImage";
import hasZoomableImage from "@utils/hasZoomableImage";

const { page } = Astro.props;

await useAstroImage(page.content);

// Only the zoomable-image lightbox needs client JS. Mux video is a plain
// <mux-player> custom element enhanced by the vanilla script below —
// everything else in the rich text is static HTML.
const needsHydration = hasZoomableImage(page.content);
---

<Section class={["mb-15"]} id="content">
  <div class="relative">
    <!-- The design puts the spy inside the container beside the article
         (981 + 219 of 1200), not floating in the page margin.

         `hidden md:block` matters as much as the positioning: the spy itself
         is hidden below `md`, but this wrapper is not part of it, and an empty
         absolutely-positioned box still hit-tests. Left visible it covers the
         rightmost 18.25% of the article's full height on mobile, swallowing
         clicks on anything right-aligned inside the article — the carousel's
         next button, for one. -->
    <div class="hidden md:block absolute right-0 top-10 h-full w-[18.25%]">
      <ScrollSpy page={page} />
    </div>
    <!-- 981 of the design's 1200 content width, leaving 220 for the scroll
         spy alongside. -->
    <article class="flow-root md:w-[81.75%] md:w-max-[60ch] md:pe-4 pb-21 border-solid border-be-1 border-gray-300">
      {
        needsHydration ? (
          <RichTextLexical data={page.content} client:idle />
        ) : (
          <RichTextLexical data={page.content} />
        )
      }
    </article>
  </div>
</Section>

<script>
  const wrappers = document.querySelectorAll<HTMLElement>(
    ".mux-video-wrapper mux-player",
  );

  if (wrappers.length) {
    import("@mux/mux-player");

    const players = Array.from(wrappers);

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const player = entry.target as HTMLElement & {
            play?: () => Promise<void>;
            pause?: () => void;
          };
          if (entry.isIntersecting) {
            player.play?.()?.catch(() => {});
          } else {
            player.pause?.();
          }
        });
      },
      { rootMargin: "-40% 0px -40% 0px", threshold: 0 },
    );

    players.forEach((player) => {
      observer.observe(player);
      player.addEventListener("play", () => {
        players.forEach((other) => {
          if (other !== player) {
            (other as HTMLElement & { pause?: () => void }).pause?.();
          }
        });
      });
    });
  }
</script>
