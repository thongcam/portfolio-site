---
/**
 * Education and Work, side by side.
 *
 * Each column reveals itself when it scrolls into view: entries fade in and
 * float up one after another, and the rail between them draws downwards just
 * behind, so the timeline reads as being written top to bottom. The stagger
 * is pure CSS driven by `--entry-index`; the only thing JavaScript does is
 * add `is-revealed` at the right moment.
 *
 * The hidden starting state is gated behind `is-armed`, which JS also adds —
 * so with scripting off the entries are simply visible rather than stuck at
 * `opacity: 0`.
 */
import Section from "@components/sections/section.astro";
import TimelineEntry from "./timelineEntry.astro";

interface Props {
  education: { heading: string; entries: any[] };
  work: { heading: string; entries: any[] };
}

const { education, work } = Astro.props;

const columns = [
  { ...education, accent: "blue" as const },
  { ...work, accent: "yellow" as const },
];
---

<Section class={["bg-gray-50 py-16 md:py-20"]} id="timeline">
  <div class="flex flex-col gap-16 md:flex-row md:gap-[11%]">
    {
      columns.map((column) => (
        <div class="flex min-w-0 flex-1 flex-col gap-10 md:gap-12">
          <h2 class="text-section-title text-text-primary">{column.heading}</h2>
          <ol class="flex flex-col" data-timeline>
            {column.entries?.map((entry, index) => (
              <TimelineEntry
                entry={entry}
                accent={column.accent}
                continues={index < column.entries.length - 1}
                index={index}
              />
            ))}
          </ol>
        </div>
      ))
    }
  </div>
</Section>

<!-- `is:global` because the entries are rendered by timelineEntry.astro:
     Astro's scoped styles stamp a per-component attribute onto the markup in
     *this* file only, so a scoped descendant selector would never match them
     and the entries would simply never animate. The `data-timeline-*`
     attributes are the namespace instead. -->
<style is:global>
  @keyframes timeline-entry-in {
    from {
      opacity: 0;
      transform: translateY(1.5rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes timeline-rail-draw {
    from {
      transform: scaleY(0);
    }
    to {
      transform: scaleY(1);
    }
  }

  /* `is-armed` is added by the script below, so this hidden state only ever
     applies where the script can undo it. */
  [data-timeline].is-armed [data-timeline-entry] {
    opacity: 0;
  }

  [data-timeline].is-armed [data-timeline-rail] {
    transform: scaleY(0);
  }

  [data-timeline].is-armed.is-revealed [data-timeline-entry] {
    animation: timeline-entry-in 520ms cubic-bezier(0, 0, 0.2, 1) forwards;
    animation-delay: calc(var(--entry-index) * 320ms);
  }

  /* Starts shortly after its own entry has appeared and runs into the next
     one, so the line always seems to be leading the way down. */
  [data-timeline].is-armed.is-revealed [data-timeline-rail] {
    animation: timeline-rail-draw 320ms cubic-bezier(0.4, 0, 0.2, 1) forwards;
    animation-delay: calc(var(--entry-index) * 320ms + 200ms);
  }

  @media (prefers-reduced-motion: reduce) {
    [data-timeline].is-armed [data-timeline-entry],
    [data-timeline].is-armed [data-timeline-rail] {
      opacity: 1;
      transform: none;
      animation: none !important;
    }
  }
</style>

<script>
  const timelines = document.querySelectorAll<HTMLElement>("[data-timeline]");

  timelines.forEach((timeline) => timeline.classList.add("is-armed"));

  const observer = new IntersectionObserver(
    (entries, obs) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add("is-revealed");
        // One-shot: the timeline should not replay every time it is scrolled
        // back past.
        obs.unobserve(entry.target);
      });
    },
    { rootMargin: "0px 0px -15% 0px", threshold: 0.05 },
  );

  timelines.forEach((timeline) => observer.observe(timeline));
</script>
